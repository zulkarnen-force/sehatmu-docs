{
  "name": "docusaurus-template-openapi-docs",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "start:prod": "docusaurus start --config docusaurus.config.prod.js",
    "start:dev": "docusaurus start --config docusaurus.config.dev.js",
    "build": "docusaurus build",
    "build:prod": "docusaurus build --config docusaurus.config.prod.js",
    "build:dev": "docusaurus build --config docusaurus.config.dev.js",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "deploy:prod": "docusaurus deploy --config docusaurus.config.prod.js",
    "deploy:dev": "docusaurus deploy --config docusaurus.config.dev.js",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "serve:prod": "docusaurus serve --config docusaurus.config.prod.js",
    "serve:dev": "docusaurus serve --config docusaurus.config.dev.js",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "gen-api-docs": "docusaurus gen-api-docs",
    "clean-api-docs": "docusaurus clean-api-docs",
    "gen-api-docs:version": "docusaurus gen-api-docs:version",
    "clean-api-docs:version": "docusaurus clean-api-docs:version",
    "regenerate": "npm run clean-api-docs all && npm run gen-api-docs all && npm run start",
    "regenerate:prod": "npm run clean-api-docs all && npm run gen-api-docs all && npm run start:prod",
    "regenerate:dev": "npm run clean-api-docs all && npm run gen-api-docs all && npm run start:dev"
  },
  "dependencies": {
    "@docusaurus/core": ">=2.0.1 <2.3.0",
    "@docusaurus/preset-classic": ">=2.0.1 <2.3.0",
    "@mdx-js/react": "^1.6.22",
    "clsx": "^1.1.1",
    "docusaurus-plugin-openapi-docs": "^1.7.0",
    "docusaurus-theme-openapi-docs": "^1.7.0",
    "prism-react-renderer": "^1.3.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
